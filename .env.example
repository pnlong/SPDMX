# Copy to .env and edit paths for your machine:
#   cp .env.example .env
#
# All other pipeline settings remain in shared/config.py.

# PDMX metadata CSV (input dataset index).
SPDMX_PDMX_FILEPATH="/deepfreeze/pnlong/PDMX/PDMX/PDMX.csv"

# Root for all spdmx outputs (dev ablations, analysis, released SPDMX/ tree).
SPDMX_OUTPUT_DIR="/deepfreeze/share/SPDMX"

# Soundfont library directory (fluidsynth). Optional if ./soundfonts symlink exists.
SPDMX_SOUNDFONT_DIR="/deepfreeze/share/pnlong/soundfonts"

# Optional: override the default production soundfont file (else SGM-V2.01.sf2 in dir above).
# SPDMX_SOUNDFONT_PATH="/deepfreeze/share/pnlong/soundfonts/SGM-V2.01.sf2"
